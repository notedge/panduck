{
    "schema": "panduck.coverage.matrix",
    "format": "typst",
    "spec": "Typst syntax reference",
    "features": [
        {
            "id": "typst-markup-text",
            "spec": "Typst syntax reference, Markup",
            "semantics": "plain markup text becomes paragraph text",
            "source": "plain text\n",
            "probe": { "contains": ["<p>plain text</p>"] }
        },
        {
            "id": "typst-heading",
            "spec": "Typst syntax reference, Headings",
            "semantics": "`= Title` becomes a first level heading",
            "source": "= Title\n",
            "probe": { "contains": ["<h1>Title</h1>"] }
        },
        {
            "id": "typst-bullet-list",
            "spec": "Typst syntax reference, Lists",
            "semantics": "dash items become an unordered list",
            "source": "- a\n- b\n",
            "probe": { "contains": ["<ul>", "<li>a</li>", "<li>b</li>"] }
        },
        {
            "id": "typst-numbered-list",
            "spec": "Typst syntax reference, Lists",
            "semantics": "plus items become an ordered list",
            "source": "+ a\n+ b\n",
            "probe": { "contains": ["<ol>", "<li>a</li>", "<li>b</li>"] }
        },
        {
            "id": "typst-let-binding",
            "spec": "Typst syntax reference, Code mode and bindings",
            "semantics": "`#let` binds a value without rendering it",
            "source": "#let x = 1\n",
            "probe": { "excludes": ["#let", "x = 1"], "count": { "<p>": 0 } }
        },
        {
            "id": "typst-inline-math",
            "spec": "Typst syntax reference, Math",
            "semantics": "`$x$` becomes inline math",
            "source": "inline $x$ math\n",
            "probe": { "contains": ["class=\"math\"", "data-language=\"typst\"", "x"] }
        },
        {
            "id": "typst-block-math",
            "spec": "Typst syntax reference, Math",
            "semantics": "`$ x = 1 $` becomes display math",
            "source": "$ x = 1 $\n",
            "probe": { "contains": ["<div class=\"math\"", "x = 1"] }
        },
        {
            "id": "typst-set-rule",
            "spec": "Typst syntax reference, Set rules",
            "semantics": "`#set text(size: 10pt)` changes styling for following content",
            "source": "#set text(size: 10pt)\ntext\n",
            "probe": { "contains": ["<p>text</p>"], "excludes": ["#set"] }
        },
        {
            "id": "typst-show-rule",
            "spec": "Typst syntax reference, Show rules",
            "semantics": "`#show heading: it => it` rewrites heading output",
            "source": "#show heading: it => it\n= Title\n",
            "probe": { "contains": ["<h1>Title</h1>"], "excludes": ["#show"] }
        },
        {
            "id": "typst-function-call",
            "spec": "Typst syntax reference, Function calls and content blocks",
            "semantics": "`#text(...)[...]` applies a style to the bracketed content",
            "source": "#text(fill: red)[hi]\n",
            "probe": { "unsupported": true }
        },
        {
            "id": "typst-comment",
            "spec": "Typst syntax reference, Comments",
            "semantics": "text after `//` to the line end contributes nothing",
            "source": "a // hidden\n",
            "probe": { "contains": ["<p>a</p>"], "excludes": ["hidden"] }
        },
        {
            "id": "typst-escape",
            "spec": "Typst syntax reference, Escaping",
            "semantics": "`\\#` is a literal hash rather than code syntax",
            "source": "\\# tag\n",
            "probe": { "contains": ["# tag"] }
        },
        {
            "id": "typst-table",
            "spec": "Typst syntax reference, Tables",
            "semantics": "`#table` lays cells out as a grid with two columns",
            "source": "#table(columns: 2, [a], [b])\n",
            "probe": { "unsupported": true }
        },
        {
            "id": "typst-figure",
            "spec": "Typst syntax reference, Figures",
            "semantics": "`#figure` keeps its body and caption together",
            "source": "#figure([x], caption: [C])\n",
            "probe": { "unsupported": true }
        },
        {
            "id": "typst-dynamic-content",
            "spec": "Typst syntax reference, Code mode expressions",
            "semantics": "`#(1 + 2)` evaluates to the text 3",
            "source": "#(1 + 2)\n",
            "probe": { "unsupported": true }
        }
    ]
}
