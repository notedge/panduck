{
    "name": "@notedge/panduck",
    "version": "0.0.17",
    "description": "Convert Word, Markdown, EPUB and related files locally; CLI and Node API with honest loss reports",
    "type": "module",
    "license": "MPL-2.0",
    "bin": {
        "panduck": "bin/panduck"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./node": {
            "types": "./dist/node/index.d.ts",
            "default": "./dist/node/index.js"
        },
        "./wasm": {
            "types": "./dist/wasm/index.d.ts",
            "default": "./dist/wasm/index.js"
        },
        "./cli": {
            "types": "./dist/cli/index.d.ts",
            "default": "./dist/cli/index.js"
        }
    },
    "types": "./dist/index.d.ts",
    "files": [
        "bin",
        "dist",
        "locales",
        "readme.md"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test:e2e": "pnpm build && tsx --test tests/**/*.test.ts"
    },
    "dependencies": {
        "@notedge/panduck-unknown-wasm32": "workspace:*",
        "@vmz/commander": "^0.2.0"
    },
    "optionalDependencies": {
        "@notedge/panduck-darwin-arm64": "workspace:*",
        "@notedge/panduck-darwin-x64": "workspace:*",
        "@notedge/panduck-linux-arm64": "workspace:*",
        "@notedge/panduck-linux-x64": "workspace:*",
        "@notedge/panduck-win32-x64": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "tsx": "^4.19.3",
        "typescript": "^5.8.3"
    }
}
