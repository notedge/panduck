{
    "name": "@notedge/panduck",
    "version": "0.0.0",
    "description": "Panduck document conversion bindings (Node-API + TypeScript)",
    "type": "module",
    "license": "MPL-2.0",
    "bin": {
        "panduck": "./bin/panduck.mjs"
    },
    "exports": {
        ".": "./src/index.ts",
        "./node": "./src/node/index.ts",
        "./wasm": "./src/wasm/index.ts",
        "./cli": "./src/cli/index.ts"
    },
    "files": [
        "bin",
        "locales",
        "src"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test:e2e": "tsx --test tests/**/*.test.ts"
    },
    "dependencies": {
        "@vmz/commander": "^0.2.0",
        "jiti": "^2.4.2"
    },
    "optionalDependencies": {
        "@notedge/panduck-darwin-arm64": "workspace:*",
        "@notedge/panduck-darwin-x64": "workspace:*",
        "@notedge/panduck-linux-arm64": "workspace:*",
        "@notedge/panduck-linux-x64": "workspace:*",
        "@notedge/panduck-win32-x64": "workspace:*",
        "@notedge/panduck-unknown-wasm32": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "tsx": "^4.19.3",
        "typescript": "^5.8.3"
    }
}
