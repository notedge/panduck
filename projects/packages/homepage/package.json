{
    "name": "@notedge/homepage",
    "version": "0.0.2",
    "private": true,
    "type": "module",
    "description": "Panduck marketing homepage (VMZ static site with @notedge/panduck probe)",
    "scripts": {
        "check": "node ../../../scripts/ensure-vmz-host-manifest.mjs && vmz check .",
        "build": "node ../../../scripts/ensure-vmz-host-manifest.mjs && vmz build --release --profile static .",
        "dev": "node ../../../scripts/ensure-vmz-host-manifest.mjs && vmz dev .",
        "preview": "vmz serve --profile static .",
        "test:panduck": "pnpm --filter @notedge/panduck test:e2e"
    },
    "dependencies": {
        "@notedge/panduck": "0.0.2",
        "@vmz/core": "0.2.7",
        "@vmz/ui": "0.2.7"
    },
    "devDependencies": {
        "@vmz/vmz": "0.2.7"
    }
}
