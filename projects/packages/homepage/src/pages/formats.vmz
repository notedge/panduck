<template>
  <div class="panduck-formats-page">
    <header class="panduck-site-header">
      <Link class="panduck-site-header__brand" href="/"><strong>Panduck</strong></Link>
      <nav class="panduck-site-header__nav" aria-label="Primary">
        <Link href="/">Home</Link>
        <Link href="/formats">Formats</Link>
      </nav>
    </header>
    <main>
      <h1>@notedge/panduck probe</h1>
      <p class="panduck-formats-page__lede">
        WASM in the browser when `public/panduck_wasm_bg.wasm` is staged. Node self-test runs without a browser.
      </p>

      <Card title="Probe results" description="Live binding capabilities.">
        <dl class="panduck-formats-page__probe">
          <div><dt>version()</dt><dd>{{ panduckVersion }}</dd></div>
          <div><dt>backend</dt><dd>{{ panduckBackend }}</dd></div>
          <div><dt>supportedFormats()</dt><dd>{{ panduckFormats }}</dd></div>
          <div><dt>isSupportedFormat('markdown')</dt><dd>{{ panduckMarkdown }}</dd></div>
        </dl>
      </Card>

      <Card title="Node self-test" description="CI / local verify without a browser.">
        <CodeBlock
          :code="selfTestSample"
          caption="shell"
          copy-label="Copy"
          @copy="() => this.copySelfTest()"
        />
      </Card>
    </main>
  </div>
</template>

<style>
  .panduck-site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--vmz-line-default, #e2e8f0);
  }
  .panduck-site-header__brand {
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--vmz-text-ink, #0f172a);
  }
  .panduck-site-header__nav {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .panduck-formats-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 0 1.25rem 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .panduck-formats-page h1 {
    margin: 0;
  }
  .panduck-formats-page__lede {
    margin: 0;
    color: var(--vmz-text-steel, #475569);
    line-height: 1.55;
  }
  .panduck-formats-page__probe {
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .panduck-formats-page__probe div {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 0.5rem;
    font-family: var(--vmz-font-mono, ui-monospace, monospace);
    font-size: 0.85rem;
  }
  .panduck-formats-page__probe dt {
    color: var(--vmz-text-steel, #475569);
  }
  .panduck-formats-page__probe dd {
    margin: 0;
  }
</style>

<script client>
import { probePanduck } from '../lib/panduck-probe.ts';

export default class FormatsPage {
    selfTestSample = 'pnpm --filter @notedge/homepage test:panduck';
    panduckVersion = '';
    panduckBackend = '';
    panduckFormats = '';
    panduckMarkdown = '';

    async onMount() {
        const probe = await probePanduck();
        this.panduckVersion = probe.version;
        this.panduckBackend = probe.backend;
        this.panduckFormats = probe.formats.join(', ');
        this.panduckMarkdown = probe.markdownOk ? 'ok' : 'fail';
    }

    async copySelfTest() {
        const text = String(this.selfTestSample || '');
        if (!text || typeof navigator === 'undefined' || !navigator.clipboard?.writeText) return;
        try {
            await navigator.clipboard.writeText(text);
        } catch {
            /* ignore */
        }
    }
}
</script>
