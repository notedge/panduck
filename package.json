{
    "private": true,
    "packageManager": "pnpm@9.15.0",
    "scripts": {
        "build": "cargo build --release",
        "build:napi": "node scripts/build-napi.mjs",
        "build:wasm": "node scripts/build-wasm.mjs",
        "test": "cargo test --release && pnpm --filter @notedge/panduck test:e2e",
        "test:e2e": "pnpm --filter @notedge/panduck test:e2e",
        "typecheck": "pnpm --filter @notedge/panduck typecheck",
        "homepage:dev": "pnpm --filter @notedge/homepage dev",
        "homepage:build": "pnpm --filter @notedge/homepage build",
        "homepage:check": "pnpm --filter @notedge/homepage check",
        "placeholder": "nifty publish --placeholder --dry-run",
        "placeholder:publish": "nifty publish --placeholder",
        "placeholder:trust": "nifty trust"
    },
    "devDependencies": {
        "@doki-land/nifty": "^0.1.9",
        "@notedge/panduck": "workspace:*",
        "@napi-rs/cli": "^3.10.9"
    }
}
